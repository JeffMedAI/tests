# JeffLocal secrets — TEMPLATE. Copy to `secrets.env` in this folder and fill in.
#
#     copy config\secrets.env.example config\secrets.env
#
# `secrets.env` is gitignored (via the `config/*secret*` rule in .gitignore) and
# must NEVER be committed. This .example file is the only one that is tracked —
# keep real values out of it.
#
# Loaded into the environment at service start by
# scripts\service_control\_load_secrets.ps1, which the launchers call before
# starting uvicorn. Changing a value here requires a dashboard restart to take
# effect:
#
#     powershell -File scripts\service_control\restart_all.ps1 -DashOnly
#
# Format: KEY=value, one per line. `#` starts a comment. Values may be quoted.
# Only the first `=` splits, so base64 values with padding are fine.
#
# After creating secrets.env, lock it down so it isn't world-readable:
#
#     icacls config\secrets.env /inheritance:r /grant:r "%USERNAME%:(R)"


# Shared secret for the Jeff (Hostcomm) voice-AI webhook. Must be set before any
# live Jeff traffic — this has been a standing pre-go-live blocker.
JEFF_WEBHOOK_SECRET=

# Shared secret for the St Marks Pharmacy contact-form intake endpoint
# (POST /api/intake/stmarks-contact). Must match the value set on the St Marks
# Cloudflare Worker side via `wrangler secret put STMARKS_INTAKE_SECRET`.
# While unset, the endpoint fails closed with 503 and no St Marks data flows.
STMARKS_INTAKE_SECRET=

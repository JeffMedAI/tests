# Tenant config TEMPLATE — copy this file to onboard a new tenant.
#
#     copy config\tenants\_template.env.example config\tenants\<tenant-name>.env
#
# <tenant-name> must match [a-zA-Z0-9_-]+ (also the -Tenant value passed to
# _launch_dashboard.ps1 and the filename itself). No spaces, no path separators.
#
# NO PATIENT DATA. NO SECRETS. This is plumbing only: which database, which
# port. Tenant secrets are a separate mechanism (see
# governance/MULTI_TENANCY_PROPOSAL.md §8 step 6 — not yet built).
#
# Loaded by scripts\service_control\_load_tenant_config.ps1, which
# _launch_dashboard.ps1 calls when given -Tenant <name>. A tenant with no
# config file here fails to start rather than silently running on the wrong
# database or port.
#
# Give every tenant a DIFFERENT port and a DIFFERENT database path. Reusing
# either from another tenant is the one mistake this file cannot catch for you.

# Human-readable name, logged on every request that touches this instance.
JEFFLOCAL_TENANT_NAME=

# This tenant's own SQLite file. Must not be shared with any other tenant.
JEFFLOCAL_DB_PATH=C:\JeffLocal\dashboard\data\tenants\<tenant-name>.sqlite

# This tenant's own port. Must not collide with any other tenant or service.
# 8765 is reserved for the default (no -Tenant) instance — do not reuse it.
JEFFLOCAL_PORT=

# Python / dashboard
__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/

# Local databases / live runtime state
dashboard/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Logs and audits may contain sensitive operational data
logs/
*.log
*.jsonl

# Queues and outputs may contain patient/call data
queue/
outputs/
data/
data/patient_lookup/
data/test_inputs/

# Local secrets / config
.mcp.json
config/local_secrets.json
config/*secret*
config/*token*
config/*key*
# ...but the template documenting WHICH keys exist is tracked. It holds no real
# values. Without this negation the `config/*secret*` rule above would hide it.
!config/secrets.env.example

# Tenant config is non-secret plumbing by design (see
# config/tenants/_template.env.example), but future tenant .env files are
# ignored by default anyway — a mistake that puts a secret in one should not
# also commit it. Explicitly allow the template and the placeholder test
# fixture used to build this feature.
config/tenants/*.env
!config/tenants/_template.env.example
!config/tenants/test-tenant-1.env
!config/tenants/tenant2.env
*.key
*.pem

# Backups / restore packs may contain sensitive data
# NOTE: graphify also reads this file (falls back to .gitignore when no
# .graphifyignore exists) — keeping historical snapshots here stops them
# polluting the code graph with duplicate copies of live files.
backup/
backups/
# Source files for backup tooling are tracked; only data files are excluded
!scripts/backup/

# Decommissioned sandbox (removed 2026-06-07) — orphaned venv + sqlite only.
# Kept out of git + the code graph; do not resurrect.
sandbox/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local manual UI backups
*.pre_figma_ui_backup

# Temp / test working dirs
.tmp/
tmp/
tmp_pytest/
JeffLocal.tmppytest/
JeffLocaltmppytest/
Temppytest_tmp/
*tmppytest*/
*.tmp
*.resync

# Dev/UX review screenshots — not source; archive externally if a record is needed
/*.png

n8n API key.txt

# Graphify AST cache — auto-generated, large, no value in git history
graphify-out/cache/

# Security runtime state — live nonces must never be in version control
config/security/

# WhatsApp message log — contains phone numbers and message history
PyWhatKit_DB.txt

# Playwright MCP test artifacts
.playwright-mcp/

# Shell-accident artefacts. These are zero-byte files created when a PowerShell
# command redirected output to a filename taken from a variable or a type name
# (">" instead of "-gt", an unquoted path, etc). They are not work.
# They are ignored by name because the session close now runs `git add -A`
# (Saeed, 2026-08-20) and must not commit rubbish. If a real file ever needs one
# of these names, remove its line here.
None
Run
found
logged
login
session
dest_db
REFERENCES
dict\[str
list\[dict\[str
churchtown.app-avamed.uk)
{,+
slug
staff_users(id)
tenant1

# Cowork's own scheduled-task storage. Not project work, and the task is retired
# (see docs/archive/cowork-daily-session-end-1800-SKILL.md). Deleting the task in
# Cowork removes this folder.
Scheduled/

# SMCPHARMA is its own git repository (the St Marks pharmacy website, separate
# remote, separate deploy). It must NOT be committed into this one - `git add -A`
# would otherwise add it as a broken submodule pointer that moves every night.
# Saeed's rule: these are separate projects.
SMCPHARMA/

# graphify-out is a GENERATED code map, not source. Rebuilt from scratch by
# `graphify update .` in ~15 seconds, so versioning it buys nothing and costs a
# lot: graph.json alone is ~3MB, and graphify writes a DATED BACKUP of itself
# (~2.5MB) on every single run - so a nightly refresh would add ~900MB/year to
# the repo. The nightly close refreshes it on disk and prunes old snapshots.
graphify-out/

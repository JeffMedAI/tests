# Python / dashboard
__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/

# Local databases / live runtime state
dashboard/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Logs and audits may contain sensitive operational data
logs/
*.log
*.jsonl

# Queues and outputs may contain patient/call data
queue/
outputs/
data/
data/patient_lookup/
data/test_inputs/

# Local secrets / config
.mcp.json
config/local_secrets.json
config/*secret*
config/*token*
config/*key*
*.key
*.pem

# Backups / restore packs may contain sensitive data
# NOTE: graphify also reads this file (falls back to .gitignore when no
# .graphifyignore exists) — keeping historical snapshots here stops them
# polluting the code graph with duplicate copies of live files.
backup/
backups/

# Decommissioned sandbox (removed 2026-06-07) — orphaned venv + sqlite only.
# Kept out of git + the code graph; do not resurrect.
sandbox/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local manual UI backups
*.pre_figma_ui_backup

# Temp / test working dirs
.tmp/
JeffLocal.tmppytest/

n8n API key.txt

# Graphify AST cache — auto-generated, large, no value in git history
graphify-out/cache/

# Security runtime state — live nonces must never be in version control
config/security/

# WhatsApp message log — contains phone numbers and message history
PyWhatKit_DB.txt

# Playwright MCP test artifacts
.playwright-mcp/

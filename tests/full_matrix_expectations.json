  "_meta": {
    "derived_from": "Jeff.PatientMatch.ps1 (matcher) + Jeff.Handoff.ps1 (disposition) + mock_patient_lookup_v3.csv",
    "note": "Expected verification_status is code-derived, not idealised. Where TESTING.md matrix disagrees with actual code output, the code wins and the deviation is logged in the run report. priority/safe_to_queue/filter are predictions to be confirmed against the imported cases.",
    "verification_states_the_code_emits": ["matched", "possible_match", "needs_review", "no_match", "insufficient_data"],
    "matcher_rules": {
      "matched": "exactly one candidate, same DOB AND exact normalised name (name_score>=95)",
      "possible_match": "top candidate same DOB AND score>=130 (DOB + similar-but-not-exact name)",
      "needs_review": "name-only candidate (name_score>=50, DOB not equal) OR multiple exact matches",
      "no_match": "no candidate met threshold",
      "insufficient_data": "patient_name or dob blank"
    },
    "disposition_rules": {
      "staff_review_required_true_if": "verification!=matched OR callback missing OR request_type in {sick_note,referral,test_result,appointment_redirect,unknown,needs_review} OR urgent subtype",
      "priority": "red_flags -> '999 Emergency' & safe_to_queue false; else urgent subtype -> urgent_review; else identity uncertainty or callback missing -> review_required; else routine",
      "safe_to_queue_false_only_if": "red_flags OR SafeToQueueOverride==false"
    }
  },

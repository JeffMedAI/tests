# Sandbox environment — Churchtown Medical Centre
# This file is loaded by launch_sandbox.ps1
# To deploy for a new practice: copy this file, update the values below

ENVIRONMENT=sandbox
PRACTICE_NAME=Churchtown Medical Centre
PRACTICE_SHORT_CODE=CMC
PRACTICE_ACCENT=#005EB8

# Database — sandbox uses its own isolated DB
# DB_PATH=C:\JeffLocal\sandbox\dashboard\data\dashboard.sqlite
# (default if not set — no need to uncomment unless overriding)

# Port
PORT=5000

# Webhook HMAC (IR-01 security requirement)
# Shared secret to verify /api/n8n/test-intake-batch payloads come from the
# trusted local n8n instance. Leave blank to skip verification in dev/sandbox.
# In production Saeed must set a strong random value in the server environment.
# n8n must send header: X-Hub-Signature-256: sha256=<HMAC-SHA256 of raw body>
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JEFF_WEBHOOK_SECRET=REPLACE-BEFORE-LIVE
